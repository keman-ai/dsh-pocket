{
  "name": "dsh-pocket",
  "version": "0.1.0",
  "description": "Watch and steer your DSH agent from a phone browser: approve tool calls, send a message, stop a turn",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "remote",
    "mobile",
    "approval"
  ],
  "license": "MIT",
  "author": "Science Roam Limited",
  "homepage": "https://github.com/keman-ai/dsh-pocket#readme",
  "bugs": {
    "url": "https://github.com/keman-ai/dsh-pocket/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keman-ai/dsh-pocket.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "build": "tsdown",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.ts"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "tsdown": "^0.15.6",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": "^22.19 || >=24"
  },
  "packageManager": "pnpm@8.15.9"
}
